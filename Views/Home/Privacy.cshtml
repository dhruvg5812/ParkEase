@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4">
    <div class="card-custom p-4 p-md-5 max-w-800 mx-auto">
        <h1 class="fw-bold font-heading mb-3">Privacy &amp; Data Security Policy</h1>
        <p class="text-muted mb-4">Last Updated: October 2026</p>

        <h5 class="fw-bold font-heading">1. Information We Collect</h5>
        <p class="text-secondary small">
            ParkEase collects only necessary reservation information including full name, email address, phone number, and vehicle registration number for parking verification and gate access control.
        </p>

        <h5 class="fw-bold font-heading mt-4">2. Password &amp; Credential Protection</h5>
        <p class="text-secondary small">
            User passwords are encrypted and hashed using ASP.NET Core Identity's PBKDF2 with HMAC-SHA256. Passwords are never stored or logged in plain text.
        </p>

        <h5 class="fw-bold font-heading mt-4">3. Booking Privacy &amp; Data Access</h5>
        <p class="text-secondary small">
            Customers have isolated access strictly to their own reservations. System authorization ensures users cannot inspect, alter, or cancel bookings belonging to other accounts.
        </p>

        <h5 class="fw-bold font-heading mt-4">4. Payment &amp; Financial Security</h5>
        <p class="text-secondary small">
            ParkEase calculates parking estimates and finalized charges server-side. No sensitive payment card data is retained on the local servers.
        </p>
    </div>
</div>

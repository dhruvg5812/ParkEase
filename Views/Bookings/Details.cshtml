@model ParkEase.ViewModels.BookingDetailsViewModel
@{
    ViewData["Title"] = $"Reservation {Model.BookingReference}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-custom p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-1">
                            Booking Details
                        </span>
                        <h2 class="fw-bold font-heading mb-0">@Model.BookingReference</h2>
                        <div class="text-muted small">Booked on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                    </div>
                    <div>
                        @if (Model.BookingStatus == "Confirmed")
                        {
                            <span class="status-badge available fs-6 px-3 py-2"><i class="bi bi-check-circle"></i> Confirmed</span>
                        }
                        else if (Model.BookingStatus == "Completed")
                        {
                            <span class="status-badge completed fs-6 px-3 py-2"><i class="bi bi-flag-fill"></i> Completed</span>
                        }
                        else if (Model.BookingStatus == "Cancelled")
                        {
                            <span class="status-badge cancelled fs-6 px-3 py-2"><i class="bi bi-x-circle"></i> Cancelled</span>
                        }
                    </div>
                </div>

                <!-- Booking Information Grid -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-muted text-uppercase small">Slot &amp; Facility</h6>
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="fs-4 fw-bold text-dark font-heading mb-1">Slot @Model.SlotNumber</div>
                            <div class="fw-semibold text-primary">@Model.LocationName</div>
                            <div class="text-muted small">@Model.LocationAddress</div>
                            <div class="mt-2">
                                <span class="badge bg-secondary">Vehicle: @Model.VehicleType</span>
                                <span class="badge bg-dark">Plate: @Model.VehicleNumber</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold text-muted text-uppercase small">Time &amp; Charges</h6>
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">Start:</span>
                                <span class="fw-semibold small">@Model.StartDateTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">End:</span>
                                <span class="fw-semibold small">@Model.EndDateTime.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted small">Rate Applied:</span>
                                <span class="fw-semibold small">₹@Model.HourlyRateAtBooking.ToString("N2")/hr</span>
                            </div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-muted small">Estimated Charge:</span>
                                <span class="fs-5 fw-bold text-primary font-heading">₹@Model.EstimatedFee.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Parking Session Arrival / Departure Status -->
                <div class="mb-4">
                    <h6 class="fw-bold text-muted text-uppercase small">Barrier Check-In / Check-Out Log</h6>
                    @if (Model.Session != null)
                    {
                        <div class="p-3 bg-white border rounded-3 shadow-sm">
                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <span class="text-muted small">Recorded Arrival:</span>
                                    <div class="fw-bold text-success">
                                        <i class="bi bi-box-arrow-in-right me-1"></i>
                                        @Model.Session.CheckInTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <span class="text-muted small">Recorded Departure:</span>
                                    <div class="fw-bold text-primary">
                                        @if (Model.Session.CheckOutTime.HasValue)
                                        {
                                            <span>
                                                <i class="bi bi-box-arrow-right me-1"></i>
                                                @Model.Session.CheckOutTime.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success">Vehicle Currently On Site</span>
                                        }
                                    </div>
                                </div>
                                @if (Model.Session.FinalFee.HasValue)
                                {
                                    <div class="col-12 border-top pt-2 mt-2 d-flex justify-content-between align-items-center">
                                        <span class="text-muted small">
                                            Actual Parking Duration: @Model.Session.ActualDurationMinutes mins
                                        </span>
                                        <div>
                                            <span class="text-muted small me-2">Final Recorded Fee:</span>
                                            <span class="fs-4 fw-bold text-success font-heading">₹@Model.Session.FinalFee.Value.ToString("N2")</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 bg-light border rounded-3 text-muted small">
                            <i class="bi bi-info-circle me-1 text-primary"></i>
                            Vehicle has not arrived yet. Present reference <strong>@Model.BookingReference</strong> to the parking attendant upon entry.
                        </div>
                    }
                </div>

                <!-- Cancellation Info if cancelled -->
                @if (Model.CancelledAt.HasValue)
                {
                    <div class="p-3 bg-danger-subtle border border-danger-subtle rounded-3 small text-danger mb-4">
                        <i class="bi bi-x-circle-fill me-1"></i>
                        This reservation was cancelled on @Model.CancelledAt.Value.ToString("dd MMM yyyy, hh:mm tt").
                    </div>
                }

                <!-- Actions -->
                <div class="d-flex flex-wrap gap-2 pt-3 border-top justify-content-between align-items-center">
                    <a asp-action="MyBookings" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to My Bookings
                    </a>

                    <div class="d-flex gap-2">
                        <button type="button" onclick="printParkingPermit()" class="btn btn-outline-primary px-3">
                            <i class="bi bi-printer me-1"></i> Print
                        </button>

                        @if (Model.CanCancel)
                        {
                            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel this booking?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger px-4">
                                    <i class="bi bi-x-circle me-1"></i> Cancel Reservation
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

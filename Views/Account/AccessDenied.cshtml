@{
    ViewData["Title"] = "Access Restricted";
}

<div class="container py-5 text-center">
    <div class="card-custom p-5 max-w-600 mx-auto">
        <div class="rounded-circle bg-danger-subtle text-danger mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2.5rem;">
            <i class="bi bi-shield-x"></i>
        </div>
        <h2 class="fw-bold font-heading mb-2">Access Denied</h2>
        <p class="text-secondary mb-4">
            You do not have permission to view this resource. This section requires Administrator privileges or appropriate role permissions.
        </p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-house me-1"></i> Return to Home
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-4">
                Switch Account
            </a>
        </div>
    </div>
</div>

@model ParkEase.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card-custom p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fs-2" style="width: 64px; height: 64px; font-weight: 700;">
                        @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U")
                    </div>
                    <div>
                        <h3 class="fw-bold font-heading mb-0">@Model.FullName</h3>
                        <p class="text-muted small mb-0">Member since @Model.CreatedAt.ToString("MMMM yyyy") &bull; @Model.TotalBookings Bookings</p>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Email" class="form-control bg-light" readonly />
                        <div class="form-text small">Your registered login email address cannot be changed directly.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Update Profile
                        </button>
                        <a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-outline-secondary px-4">
                            View My Bookings
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model ParkEase.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card-custom p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="brand-icon-box mx-auto mb-3" style="width: 48px; height: 48px; font-size: 1.4rem;">
                        <i class="bi bi-p-square-fill"></i>
                    </span>
                    <h3 class="fw-bold font-heading mb-1">Welcome to ParkEase</h3>
                    <p class="text-muted small">Sign in to manage your parking bookings</p>
                </div>

                <!-- Demo Credentials Quick-Fill Alert -->
                <div class="p-3 mb-4 rounded-3 bg-light border">
                    <div class="small fw-bold text-muted mb-2 text-uppercase">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Logins:
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" id="fillAdminCredentials" class="btn btn-outline-primary btn-sm flex-fill">
                            <i class="bi bi-shield-lock me-1"></i> Fill Admin
                        </button>
                        <button type="button" id="fillCustomerCredentials" class="btn btn-outline-secondary btn-sm flex-fill">
                            <i class="bi bi-person me-1"></i> Fill Customer
                        </button>
                    </div>
                </div>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope text-primary"></i></span>
                            <input asp-for="Email" id="loginEmail" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-semibold text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock text-primary"></i></span>
                            <input asp-for="Password" id="loginPassword" type="password" class="form-control" placeholder="Enter password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label small text-muted"></label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fs-6 shadow-sm mb-3">
                        <i class="bi bi-box-arrow-in-right me-2"></i> Sign In to Account
                    </button>
                </form>

                <div class="text-center pt-3 border-top">
                    <span class="text-muted small">Don't have an account yet?</span>
                    <a asp-controller="Account" asp-action="Register" class="text-primary fw-semibold small ms-1">Register Now</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

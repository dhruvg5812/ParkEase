@model ParkEase.ViewModels.CustomerDashboardViewModel
@{
    ViewData["Title"] = "Customer Dashboard";
}

<div class="container py-4">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-1">Customer Overview</span>
            <h1 class="h2 fw-bold font-heading mb-0">Welcome back, @Model.FullName!</h1>
            <p class="text-muted small mb-0">Manage your active permits, track expenses, and reserve spots on demand.</p>
        </div>
        <a asp-controller="Parking" asp-action="Index" class="btn btn-primary px-4 shadow-sm">
            <i class="bi bi-search me-1"></i> Book a Parking Slot
        </a>
    </div>

    <!-- Quick Stat Widgets -->
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon primary">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.UpcomingBookingsCount</div>
                        <div class="stat-label">Upcoming Slots</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon success">
                        <i class="bi bi-geo-fill"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.ActiveCheckInsCount</div>
                        <div class="stat-label">Active On-Site</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon teal">
                        <i class="bi bi-ticket-detailed"></i>
                    </div>
                    <div>
                        <div class="stat-value">@Model.TotalBookings</div>
                        <div class="stat-label">Total Bookings</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon warning">
                        <i class="bi bi-currency-rupee"></i>
                    </div>
                    <div>
                        <div class="stat-value">₹@Model.TotalSpent.ToString("N0")</div>
                        <div class="stat-label">Total Expenditure</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Upcoming Reservations Section -->
    <div class="card-custom mb-4">
        <div class="card-custom-header">
            <h5 class="fw-bold font-heading mb-0">
                <i class="bi bi-clock-history text-primary me-2"></i>Upcoming &amp; Active Reservations
            </h5>
            <a asp-controller="Bookings" asp-action="MyBookings" class="btn btn-outline-primary btn-sm">
                View All Bookings <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-custom-body p-0">
            @if (!Model.UpcomingBookings.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-check2-circle fs-3 d-block text-success mb-2"></i>
                    You have no upcoming reservations. Need parking today?
                    <div class="mt-2">
                        <a asp-controller="Parking" asp-action="Index" class="btn btn-sm btn-primary">Find a Bay</a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Booking Ref</th>
                                <th>Location &amp; Stall</th>
                                <th>Vehicle Plate</th>
                                <th>Schedule</th>
                                <th>Estimated Fee</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.UpcomingBookings)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="fw-bold text-primary text-decoration-none">
                                            @b.BookingReference
                                        </a>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">Slot @b.ParkingSlot?.SlotNumber</div>
                                        <div class="text-muted small">@b.ParkingSlot?.ParkingLocation?.Name</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@b.VehicleNumber</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@b.StartDateTime.ToString("dd MMM, hh:mm tt")</div>
                                        <div class="text-muted small">until @b.EndDateTime.ToString("dd MMM, hh:mm tt")</div>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-dark">₹@b.EstimatedFee.ToString("N2")</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Bookings" asp-action="Confirmation" asp-route-id="@b.Id" class="btn btn-outline-primary btn-sm">
                                            <i class="bi bi-qr-code me-1"></i> Permit
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent History Section -->
    <div class="card-custom">
        <div class="card-custom-header">
            <h5 class="fw-bold font-heading mb-0">
                <i class="bi bi-journal-text text-secondary me-2"></i>Recent Reservation History
            </h5>
        </div>
        <div class="card-custom-body p-0">
            @if (!Model.RecentBookings.Any())
            {
                <div class="p-4 text-center text-muted">
                    No past reservation history found.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Slot Number</th>
                                <th>Date</th>
                                <th>Final Charge</th>
                                <th>Status</th>
                                <th class="text-end">Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="font-monospace fw-semibold">@b.BookingReference</td>
                                    <td>Slot @b.ParkingSlot?.SlotNumber</td>
                                    <td>@b.StartDateTime.ToString("dd MMM yyyy")</td>
                                    <td class="fw-bold">₹@((b.Session?.FinalFee ?? b.EstimatedFee).ToString("N2"))</td>
                                    <td>
                                        @if (b.BookingStatus == "Completed")
                                        {
                                            <span class="status-badge completed">Completed</span>
                                        }
                                        else if (b.BookingStatus == "Confirmed")
                                        {
                                            <span class="status-badge available">Confirmed</span>
                                        }
                                        else if (b.BookingStatus == "Cancelled")
                                        {
                                            <span class="status-badge cancelled">Cancelled</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="btn btn-outline-secondary btn-sm">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

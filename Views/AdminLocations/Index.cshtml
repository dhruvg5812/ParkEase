@model IEnumerable<ParkEase.Models.ParkingLocation>
@{
    ViewData["Title"] = "Manage Parking Locations";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Index">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Locations</li>
                </ol>
            </nav>
            <h1 class="h2 fw-bold font-heading mb-0">Parking Facilities &amp; Hubs</h1>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Add New Location
        </a>
    </div>

    <div class="card-custom">
        <div class="card-custom-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Facility Name</th>
                            <th>Address</th>
                            <th>Capacity / Slots</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark font-heading">@item.Name</div>
                                    <div class="text-secondary small text-truncate" style="max-width: 250px;">
                                        @(item.Description ?? "No description added.")
                                    </div>
                                </td>
                                <td>
                                    <div class="small text-muted"><i class="bi bi-geo-alt text-danger me-1"></i>@item.Address</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary fw-bold px-2 py-1">
                                        @item.ParkingSlots.Count Total Slots
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle me-1"></i> Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">
                                            <i class="bi bi-pause-circle me-1"></i> Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="text-muted small">@item.CreatedAt.ToString("dd MMM yyyy")</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm" title="Edit Facility">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning btn-sm" title="Toggle Active Status">
                                                <i class="bi bi-power"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete location @item.Name? Warning: Locations with bookings cannot be deleted.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Delete Facility">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

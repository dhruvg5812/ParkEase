@model ParkEase.Models.ParkingLocation
@{
    ViewData["Title"] = "Add Parking Location";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card-custom p-4 p-md-5">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a asp-action="Index">Locations</a></li>
                        <li class="breadcrumb-item active" aria-current="page">New Location</li>
                    </ol>
                </nav>
                <h3 class="fw-bold font-heading mb-4 pb-2 border-bottom">Add New Parking Location</h3>

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Downtown Central Plaza" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold text-muted"></label>
                        <input asp-for="Address" class="form-control" placeholder="Street Address, City" />
                        <span asp-validation-for="Address" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label small fw-semibold text-muted"></label>
                        <textarea asp-for="Description" rows="3" class="form-control" placeholder="Highlights, security details, entry barriers, etc."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label small fw-semibold text-muted"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">Save Location</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

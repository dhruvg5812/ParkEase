@model ParkEase.ViewModels.BookingDetailsViewModel
@{
    ViewData["Title"] = $"Manage Reservation {Model.BookingReference}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card-custom p-4 p-md-5">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-2">
                        <li class="breadcrumb-item"><a asp-action="Index">Reservations</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.BookingReference</li>
                    </ol>
                </nav>

                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-1">
                            Administrator Control
                        </span>
                        <h2 class="fw-bold font-heading mb-0">@Model.BookingReference</h2>
                        <div class="text-muted small">Submitted on @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                    </div>
                    <div>
                        @if (Model.BookingStatus == "Confirmed")
                        {
                            <span class="status-badge available fs-6 px-3 py-2"><i class="bi bi-check-circle"></i> Confirmed</span>
                        }
                        else if (Model.BookingStatus == "Completed")
                        {
                            <span class="status-badge completed fs-6 px-3 py-2"><i class="bi bi-flag-fill"></i> Completed</span>
                        }
                        else if (Model.BookingStatus == "Cancelled")
                        {
                            <span class="status-badge cancelled fs-6 px-3 py-2"><i class="bi bi-x-circle"></i> Cancelled</span>
                        }
                        else
                        {
                            <span class="status-badge pending fs-6 px-3 py-2">@Model.BookingStatus</span>
                        }
                    </div>
                </div>

                <!-- Customer & Vehicle Info -->
                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3">Customer Information</h6>
                            <div class="fw-bold text-dark font-heading fs-5 mb-1">@Model.CustomerName</div>
                            <div class="text-secondary small mb-1"><i class="bi bi-envelope me-1"></i> @Model.CustomerEmail</div>
                            <div class="text-secondary small mb-2"><i class="bi bi-telephone me-1"></i> @(Model.CustomerPhone ?? "Not Provided")</div>
                            <div class="border-top pt-2 mt-2">
                                <span class="text-muted small">Registered Vehicle:</span>
                                <div class="fs-5 fw-bold text-dark font-monospace">@Model.VehicleNumber</div>
                                <span class="badge bg-secondary">Class: @Model.VehicleType</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border h-100">
                            <h6 class="fw-bold text-muted text-uppercase small mb-3">Slot &amp; Timing</h6>
                            <div class="fs-4 fw-bold text-dark font-heading mb-1">Slot @Model.SlotNumber</div>
                            <div class="fw-semibold text-primary">@Model.LocationName</div>
                            <div class="text-muted small mb-3">@Model.LocationAddress</div>

                            <div class="small mb-1">
                                <span class="text-muted">Start:</span> <strong>@Model.StartDateTime.ToString("dd MMM yyyy, hh:mm tt")</strong>
                            </div>
                            <div class="small mb-2">
                                <span class="text-muted">End:</span> <strong>@Model.EndDateTime.ToString("dd MMM yyyy, hh:mm tt")</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center border-top pt-2">
                                <span class="text-muted small">Estimated Total:</span>
                                <span class="fs-4 fw-bold text-primary font-heading">₹@Model.EstimatedFee.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Barrier Arrival / Check-In / Check-Out Operations -->
                <div class="p-4 rounded-3 border mb-4 bg-white shadow-sm">
                    <h5 class="fw-bold font-heading mb-3 text-dark">
                        <i class="bi bi-shield-shaded text-primary me-2"></i>Attendant Gate Check-In &amp; Check-Out
                    </h5>

                    @if (Model.Session == null)
                    {
                        <div class="alert alert-info border-0 d-flex align-items-center mb-3">
                            <i class="bi bi-info-circle-fill me-2 fs-5"></i>
                            <div>The vehicle has not checked in at the entry barrier.</div>
                        </div>

                        @if (Model.BookingStatus == "Confirmed")
                        {
                            <form asp-action="CheckIn" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-success px-4 py-2 fs-6 shadow-sm">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Record Vehicle Check-In
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="p-3 bg-success-subtle rounded-3 border border-success-subtle">
                                    <span class="text-success small fw-bold text-uppercase">Recorded Arrival Time</span>
                                    <div class="fs-5 fw-bold text-dark">
                                        @Model.Session.CheckInTime.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                    </div>
                                    <span class="badge bg-success mt-1">Status: @Model.Session.Status</span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 bg-light rounded-3 border">
                                    <span class="text-muted small fw-bold text-uppercase">Recorded Departure Time</span>
                                    <div class="fs-5 fw-bold text-dark">
                                        @if (Model.Session.CheckOutTime.HasValue)
                                        {
                                            @Model.Session.CheckOutTime.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                        }
                                        else
                                        {
                                            <span class="text-warning"><i class="bi bi-clock-history me-1"></i> Parked On-Site</span>
                                        }
                                    </div>
                                    @if (Model.Session.ActualDurationMinutes.HasValue)
                                    {
                                        <small class="text-muted">Actual Duration: @Model.Session.ActualDurationMinutes mins</small>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (Model.Session.FinalFee.HasValue)
                        {
                            <div class="p-3 bg-light rounded-3 border d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <div class="fw-bold text-dark">Final Session Charge</div>
                                    <small class="text-muted">Calculated server-side using locked rate ₹@Model.HourlyRateAtBooking.ToString("N2")/hr</small>
                                </div>
                                <div class="fs-2 fw-bold text-success font-heading">
                                    ₹@Model.Session.FinalFee.Value.ToString("N2")
                                </div>
                            </div>
                        }

                        @if (Model.CanCheckOut)
                        {
                            <form asp-action="CheckOut" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-warning px-4 py-2 fs-6 shadow-sm fw-semibold">
                                    <i class="bi bi-box-arrow-right me-2"></i> Record Check-Out &amp; Finalize Fee
                                </button>
                            </form>
                        }
                    }
                </div>

                <!-- Administrative Actions Footer -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Reservations
                    </a>

                    <div class="d-flex gap-2">
                        @if (Model.BookingStatus == "Pending")
                        {
                            <form asp-action="Confirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-primary px-3">
                                    <i class="bi bi-check-lg me-1"></i> Approve &amp; Confirm
                                </button>
                            </form>
                        }

                        @if (Model.BookingStatus != "Cancelled" && Model.BookingStatus != "Completed")
                        {
                            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this reservation as Administrator?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger px-3">
                                    <i class="bi bi-x-circle me-1"></i> Cancel Reservation
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

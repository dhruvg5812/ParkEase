@model ParkEase.Models.ParkingSlot
@{
    ViewData["Title"] = $"Slot {Model.SlotNumber} Details";
    bool isAvailableNow = ViewBag.IsAvailableNow ?? false;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card-custom p-4 p-md-5">
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <div>
                        <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-semibold mb-1">
                            @Model.ParkingLocation?.Name
                        </span>
                        <h2 class="fw-bold font-heading mb-0">Parking Slot @Model.SlotNumber</h2>
                    </div>
                    <div class="text-end">
                        <div class="fs-2 fw-bold text-primary font-heading">₹@Model.HourlyRate.ToString("N2")</div>
                        <div class="text-muted small">per billable hour</div>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <h6 class="fw-bold text-muted text-uppercase small">Slot Specifications</h6>
                        <ul class="list-group list-group-flush border rounded-3">
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Slot Identifier:</span>
                                <span class="fw-semibold">@Model.SlotNumber</span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Vehicle Category:</span>
                                <span class="fw-semibold">
                                    @if (Model.VehicleType == "Car") { <i class="bi bi-car-front text-primary me-1"></i> }
                                    else if (Model.VehicleType == "Bike") { <i class="bi bi-bicycle text-success me-1"></i> }
                                    else if (Model.VehicleType == "SUV") { <i class="bi bi-truck-front text-warning me-1"></i> }
                                    else if (Model.VehicleType == "EV") { <i class="bi bi-lightning-charge text-info me-1"></i> }
                                    @Model.VehicleType
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Slot State:</span>
                                <span class="fw-semibold">
                                    @if (Model.Status == "Available")
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else if (Model.Status == "Maintenance")
                                    {
                                        <span class="badge bg-danger">Maintenance</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@Model.Status</span>
                                    }
                                </span>
                            </li>
                            <li class="list-group-item d-flex justify-content-between">
                                <span class="text-muted">Real-Time Occupancy:</span>
                                <span class="fw-semibold">
                                    @(isAvailableNow ? "Vacant Right Now" : "Currently Occupied / Reserved")
                                </span>
                            </li>
                        </ul>
                    </div>

                    <div class="col-md-6">
                        <h6 class="fw-bold text-muted text-uppercase small">Hub Amenities</h6>
                        <div class="d-flex flex-column gap-2">
                            <div class="p-2 px-3 bg-light rounded-3 d-flex align-items-center gap-2 small">
                                <i class="bi bi-camera-video-fill text-primary"></i> 24/7 CCTV &amp; Security Guard
                            </div>
                            <div class="p-2 px-3 bg-light rounded-3 d-flex align-items-center gap-2 small">
                                <i class="bi bi-roof text-success"></i> Weather-Protected Covered Bay
                            </div>
                            <div class="p-2 px-3 bg-light rounded-3 d-flex align-items-center gap-2 small">
                                <i class="bi bi-shield-check text-info"></i> Automated QR &amp; Number Plate Entry
                            </div>
                            @if (Model.VehicleType == "EV")
                            {
                                <div class="p-2 px-3 bg-info-subtle text-info border border-info-subtle rounded-3 d-flex align-items-center gap-2 small fw-semibold">
                                    <i class="bi bi-lightning-charge-fill"></i> Fast EV Charger on Stall
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted text-uppercase small">Location &amp; Access Notes</h6>
                    <p class="text-secondary small mb-1">
                        <strong>Address:</strong> @Model.ParkingLocation?.Address
                    </p>
                    <p class="text-secondary small">
                        <strong>Description:</strong> @(Model.Description ?? "No special notes. Proceed to the designated bay number upon entry.")
                    </p>
                </div>

                <div class="d-flex gap-3 pt-3 border-top">
                    <a asp-controller="Parking" asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Slots
                    </a>
                    @if (Model.Status == "Available")
                    {
                        <a asp-controller="Bookings" asp-action="Create" asp-route-slotId="@Model.Id" class="btn btn-primary px-4 flex-fill shadow-sm">
                            <i class="bi bi-calendar-check me-2"></i> Proceed to Reservation
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-secondary px-4 flex-fill" disabled>
                            Slot Currently Unavailable
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
